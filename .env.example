# Copy to .env; keep it out of Git. Deployment settings below are production only.
# Optional display name, visible in the header (including login) and browser title.
# Leave blank to keep the default Tally appearance.
TALLY_INSTANCE_NAME=
# Monetary display and input precision: whole (default) or cents.
TALLY_MONEY_PRECISION=whole
# Built-in portfolio authentication: 1 (default) or 0 (upstream auth only).
# Use 0 only after securing the proxy and blocking all direct application access.
# Django admin still requires a staff login. CSRF protection remains enabled.
TALLY_AUTH_ENABLED=1
# Historical CSV import feature: 1 (default) or 0 (disabled).
TALLY_IMPORT_HISTORY_ENABLED=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
TALLY_HOST=tally.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
# Unique on the shared Traefik network; 1–63 lowercase letters/digits/_/-, starting alphanumeric.
TALLY_TRAEFIK_ID=tally
