# Copy to .env; keep it out of Git. Deployment settings below are production only.
# Optional display name, visible in the header (including login) and browser title.
# Leave blank to keep the default Tally appearance.
TALLY_INSTANCE_NAME=
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
TALLY_HOST=tally.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
